# Nusxa oling: cp .env.example .env
# `.env` gitignore da va u yerdan chiqmaydi (QOIDALAR.md, 3-qoida).

# ---------------------------------------------------------------- baza
SUPABASE_URL=https://<project-ref>.supabase.co
# Yozish uchun. Faqat backend va skreyperda. Brauzerga HECH QACHON tushmaydi.
SUPABASE_SERVICE_ROLE_KEY=

# Faqat o'qish uchun, brauzerga tushadi — bu normal.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ------------------------------------------------------------------- web
# Usta sahifasi (`apps/web`) SellerOS API ga shu manzil orqali
# murojaat qiladi. Chaqiruv SERVER tomonda, `/api/yonalishlar`
# marshrutida boʻladi — kalit brauzerga tushmaydi.
#
# Bu `anon` kaliti, yaʼni u ochilib qolsa ham zarar cheklangan.
# Shunga qaramay uni chiqarmaymiz: autentifikatsiya qoʻshilganda
# oʻzgaradigan joy bitta boʻlishi kerak (reja, 5-boʻlim).
SELLEROS_API_URL=https://<project-ref>.supabase.co/functions/v1/selleros
SELLEROS_API_KEY=

# Ichki oʻlchov paneli (`/olchov`) — foydalanuvchi soni, konversiya,
# obuna holati. Bu ichki biznes raqamlari, shuning uchun panel
# qulflangan.
#
# BOʻSH QOLDIRILSA PANEL HECH KIMGA OCHILMAYDI. Teskarisi — kalitsiz
# ochiq qolish — sozlash esdan chiqqanda panelni ommaga ochib
# yuborardi.
PANEL_KALITI=

# ---------------------------------------------------------------- backend
PORT=3000
NODE_ENV=development

# Xato kuzatuvi. Boʻsh boʻlsa hech narsa yuborilmaydi va bu XATO
# EMAS — mahalliy ishlashda u shunday boʻlishi kerak.
#
# SDK emas, oddiy HTTP ishlatiladi (`packages/shared/src/xatolik.ts`):
# bitta kod Node, Deno va brauzerda bir xil ishlaydi. Yaʼni manba
# xaritasi va breadcrumb yoʻq — faqat "xato boʻldi, mana u".
#
# Sentry → Projects → Settings → Client Keys (DSN) da olinadi.
SENTRY_DSN=

# --------------------------------------------------------------- skreyper
# Proksi ro'yxati, vergul bilan. Bo'sh bo'lsa to'g'ridan-to'g'ri
# yig'iladi — bu odatiy hol va XATO EMAS.
#
# Nega kerak: hozir hamma so'rov bitta IP dan ketadi. Uzum uni
# bloklasa yig'ish butunlay to'xtaydi. Bir nechta manzil bo'lsa,
# bittasi yiqilganda qolgani ishlayveradi.
#
# Ketma-ket 3 marta xato bergan manzil chetlanadi va bu hisobotda
# ko'rinadi. Hammasi chetlansa — to'g'ridan-to'g'ri davom etadi.
SKREYPER_PROKSI=

# ---------------------------------------------------------------- AI
# Ikki model: arzon — suhbatga, kuchli — kartochkaga (FORMULA.md, 3-qoida).
ANTHROPIC_API_KEY=
LLM_MODEL_CHEAP=
LLM_MODEL_STRONG=

# ---------------------------------------------------------------- bot
TELEGRAM_BOT_TOKEN=

# ---------------------------------------------------------------- to'lov
# Obuna — 149 000 soʻm/oy, faqat Payme/Click (0067; docs/TOLOV-ULASH.md).
# Sirlar FAQAT Supabase Edge Function sirlariga — chatga ham, repoga ham emas.
#
# `1` — jonli: Payme — checkout.paycom.uz va PAYME_KEY; Click sahifasi ochiladi.
# Aks holda sinov: Payme — test.paycom.uz va PAYME_TEST_KEY; Click sahifasi ochilmaydi
# (Click da sinov muhiti yoʻq — sahifasida haqiqiy pul yechiladi).
PAYMENTS_LIVE=0

# Obuna darvozasi: bepul — 1–5-qadam, 6-qadamdan obuna. Faqat `1` yoqadi.
# Payme yoki Click ulanmaguncha OʻCHIQ: aks holda hech kim 6-qadamga oʻta olmaydi.
TARIF_CHEKLOVI=0

# Payme (merchant.payme.uz → Kassa → «Инструменты разработчика»).
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_TEST_KEY=
# Fiskal chek (ixtiyoriy — buxgalter aytadi): IKPU (MXIK), qadoq kodi, QQS foizi.
PAYME_IKPU=
PAYME_PAKET_KODI=
PAYME_QQS_FOIZ=0

# Click (mc.click.uz → «Xizmatlar»).
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=

# Toʻlovdan keyin qaytish (boʻlmasa — https://zumsavdo.vercel.app/usta).
TOLOV_QAYTISH_URL=

# ---------------------------------------------------------------- 1688
IMAGE_SEARCH_PROVIDER=
IMAGE_SEARCH_KEY=

# --- 9-qadam studiyasi (Cloudflare Worker, docs/STUDIYA.md). Ikkalasini
# `scripts/studiya-ulash.cmd` qoʻyadi (Supabase secrets); boʻlmasa suratlar asl holida.
STUDIYA_URL=
STUDIYA_KALIT=

# --- Suhbat menejeri (LLM faqat jumlani odamdek aytadi; kalit boʻlmasa kod jumlasi ketadi)
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash
