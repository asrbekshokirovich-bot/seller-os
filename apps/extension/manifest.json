{
  "manifest_version": 3,
  "name": "ZumSavdo — Xitoydan top",
  "version": "0.3.0",
  "description": "Uzumda nima sotishni raqam bilan tanlang: har tovar tagida oyiga necha dona sotilishi, tovar pasporti, taqqoslash va Xitoydan (1688) top. Yon panelda ZumSavdo chati.",
  "permissions": [
    "storage",
    "sidePanel"
  ],
  "action": {
    "default_title": "ZumSavdo chatini ochish",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://uzum.uz/*",
        "*://www.uzum.uz/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "https://duequijnnzcngzzvjqst.supabase.co/*"
  ]
}
