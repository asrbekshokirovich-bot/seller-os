{
  "manifest_version": 3,
  "name": "Seller OS — Xitoydan top",
  "version": "0.2.0",
  "description": "Seller OS chati yon panelda: Uzumda nima sotishni raqamlar bilan tanlang. Uzum.uz sahifasida \"Xitoydan top\" tugmasi.",
  "permissions": [
    "activeTab",
    "storage",
    "sidePanel"
  ],
  "action": {
    "default_title": "Seller OS chatini ochish"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://uzum.uz/*",
        "*://www.uzum.uz/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "https://duequijnnzcngzzvjqst.supabase.co/*"
  ]
}
